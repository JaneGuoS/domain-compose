        },
        {
          "label": "PostAppService.CreatePostAsync \u2014 validate draft limit and permission",
          "type": "domain"
        },
        {
          "label": "UserChannelsService.GetUserChannelAsync \u2014 fetch channel membership",
          "type": "domain"
        },
        {
          "label": "PostEntity constructor \u2014 enforce attachment type rules",
          "type": "domain"
        },
        {
          "label": "PostService.CreatePostAsync \u2014 persist and update lastPostTime",
          "type": "domain"
        },
