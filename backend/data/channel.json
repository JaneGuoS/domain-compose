{
  "service": "channel",
  "analyzedAt": "2026-06-09",
  "boundedContext": {
    "owns": [
      "Channel lifecycle & membership",
      "Post lifecycle & reactions",
      "Comment threading & reactions",
      "Announcement scheduling & expiration",
      "SocialStream curation & membership",
      "SocialContent (employee advocacy posts)",
      "SocialShare scheduling & compliance",
      "UserDetails (social preferences & onboarding)",
      "GenerativeAI settings & post caching",
      "PeerToPeer content (blob uploads & video processing)",
      "UserAnnouncements (per-user filtered view)",
      "UserChannels (membership tracking)"
    ],
    "dependsOn": [
      "CMS — channel/post/comment/announcement/social persistence",
      "UMS — user identity, groups, entitlements",
      "BSS — blob storage upload URLs",
      "FMS — feature flag reads",
      "DAS — social compliance configuration and analytics",
      "VFS — video upload and processing",
      "CAS — content SAS URL and rendition generation",
      "Notification Service — push notification delivery",
      "ProofPoint — social post compliance scanning",
      "ProofPoint Native — native account deprovisioning",
      "SocialSharing Service — cross-network social share posting",
      "Matrix — tenant lifecycle and region resolution"
    ],
    "publishes": [
      "eventbus.scp.content-management-application.ingested"
    ],
    "consumes": [
      "eventbus.scp.content-function-services.rendition.updated",
      "eventbus.scp.content-function-services.vfs.processed",
      "eventbus.public.user-management.user"
    ]
  },
  "gapAnalysis": [
    {
      "id": 1,
      "title": "Infrastructure types leak into Domain layer",
      "detail": "Multiple domain services (ContentService, UserService, UserChannelsService, UserAnnouncementsService, TimezoneResolver, AIGeneratedPostService, GenerativeAISettingsService) directly import and depend on Seismic.Channel.Infrastructure.Context (IContextProvider, ITraceProvider) and even NewRelic.Api.Agent ([Trace] attribute on ItemsService, ContentService). Infrastructure concerns like tracing, tenant resolution, and monitoring should not appear in the domain layer. This breaks Dependency Rule and makes domain logic untestable without the infrastructure stack.",
      "file": "ContentService.cs",
      "severity": "P0",
      "category": "Layer violation"
    },
    {
      "id": 2,
      "title": "Application layer imports API model types",
      "detail": "SocialShareAppService, SocialStreamAppService, and SocialContentAppService have 'using Seismic.Channel.Api.Models.Social' at the top. The application layer must not depend on the API (presentation) layer. This reversal of the dependency arrow means API model changes will break application services, and the application services cannot be consumed by any other host without dragging in API models.",
      "file": "SocialShareAppService.cs",
      "severity": "P0",
      "category": "Layer violation"
    },
    {
      "id": 3,
      "title": "UMSEventConsumer performs HTTP calls inline in background consumer",
      "detail": "UMSEventConsumer.ProcessUserEventAsync directly calls IsSocialComplianceFeatureEnabledAsync (HTTP to FMS) and GetDeprovisionAuthTokenAsync (HTTP to DAS) inside the Kafka consume loop, bypassing the domain/application service boundary. Business rules about whether deprovision should proceed (feature flag gating, compliance auth-token validation) belong in a domain or application service, not in the infrastructure consumer.",
      "file": "UMSEventConsumer.cs",
      "severity": "P1",
      "category": "Layer violation"
    },
    {
      "id": 4,
      "title": "ContentService uses IServiceScopeFactory for fire-and-forget tasks",
      "detail": "ContentService (a domain service) directly receives and uses IServiceScopeFactory to create DI scopes for async Kafka publishing inside Task.Run. This is an infrastructure concern inside the domain. The fire-and-forget pattern also silently swallows errors, and the duplication of the video format list (defined twice in the same method) indicates copy-paste development. A proper domain event (ContentCreated) + infrastructure handler would eliminate this coupling.",
      "file": "ContentService.cs",
      "severity": "P1",
      "category": "Infra coupling"
    },
    {
      "id": 5,
      "title": "ICms3Manager exposes a god-interface spanning all aggregates",
      "detail": "ICms3Manager has over 60 methods covering channels, posts, comments, announcements, social content, social shares, social streams, and content files. A single interface violates the Interface Segregation Principle — any domain service taking ICms3Manager can access persistence for aggregates it does not own. It should be split per aggregate (IChannelRepository, IPostRepository, etc.), and the 'manager' naming suggests an anti-pattern.",
      "file": "ICms3Manager.cs",
      "severity": "P1",
      "category": "Layer violation"
    },
    {
      "id": 6,
      "title": "Anemic GenerativeAI and UserDetails entities",
      "detail": "GenerativeAISettingsEntity, AIGeneratedPostEntity, and UserDetailsEntity are pure data bags with no invariants, no domain methods, and [ExcludeFromCodeCoverage] attributes. All business logic (AI style validation, user preference rules) lives in AppService or domain service classes. These should be enriched with at least invariant guards and factory methods.",
      "file": "GenerativeAISettingsEntity.cs",
      "severity": "P1",
      "category": "Anemic model"
    },
    {
      "id": 7,
      "title": "Permission mutation logic leaks into ChannelAppService",
      "detail": "ChannelAppService.UpdateChannelPermissionAsync performs direct mutations on PermissionEntity (permission.AddMember, permission.UpdateMember, permission.RemoveMember, permission.BulkUpdate) and then calls the channel service for each member change. This orchestration of permission invariants belongs inside ChannelEntity or PermissionEntity as aggregate methods, not scattered across a 270-line application service method.",
      "file": "ChannelAppService.cs",
      "severity": "P1",
      "category": "Anemic model"
    },
    {
      "id": 8,
      "title": "Post featurability invariant split across AppService and Entity",
      "detail": "PostAppService.FeaturePostAsync directly sets post.IsFeatured, post.FeatureCreationTime, post.FeatureCreatedBy, post.FeatureStartDate, post.FeatureExpirationDate on the entity rather than calling a Feature() method on PostEntity. The 4-item overlap limit check is in ItemsService.ExceedsOverlapLimit rather than being expressed as a PostEntity invariant. The aggregate root should own Feature(featureRequest) with the invariant guard.",
      "file": "PostAppService.cs",
      "severity": "P2",
      "category": "Anemic model"
    },
    {
      "id": 9,
      "title": "Missing SocialCompliance domain concept",
      "detail": "Compliance data (ComplianceStatus, Compliance, ContentViolations, Violations, ComplianceCheckLog) appears as raw properties in both SocialContentEntity and SocialShareEntity with no dedicated ComplianceStatus value object or SocialCompliance aggregate. Compliance logic is scattered across SocialShareAppService.TryProcessCreateSharingWithComplianceAsync, SocialDASComplianceService, and UMSEventConsumer. A ComplianceStatus value object or ComplianceResult domain object would consolidate this.",
      "file": "SocialShareEntity.cs",
      "severity": "P2",
      "category": "Missing concept"
    },
    {
      "id": 10,
      "title": "Commented-out ContentUpdated Kafka consumer indicates incomplete design",
      "detail": "ContentUpdatedEventConsumer exists but is entirely commented out in ContentService.CreateContentAsync. IContentUpdatedEventConsumer interface remains in the domain. This dead code signals an incomplete migration away from synchronous content-update polling toward event-driven processing, leaving the design in a transitional state with unclear ownership.",
      "file": "ContentService.cs",
      "severity": "P2",
      "category": "Missing concept"
    },
    {
      "id": 11,
      "title": "N+1 pattern in bulk channel permission update",
      "detail": "ChannelAppService.UpdateChannelPermissionAsync iterates over channel.Requests and fires individual AddMemberAsync / UpdateMemberAsync / RemoveRequestAsync CMS HTTP calls per request, despite a Task.WhenAll wrapper. A batch CMS endpoint (AddMembersAsync exists on ICms3Manager but is not used here) should be used instead to avoid per-request HTTP round trips under load.",
      "file": "ChannelAppService.cs",
      "severity": "P2",
      "category": "Infra coupling"
    }
  ],
